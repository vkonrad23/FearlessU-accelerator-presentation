{
  "name": "fearlessu-cinematic-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "npm run lint && npm run typecheck && next build",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "preview": "serve out --listen tcp://127.0.0.1:3000",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "check:budget": "node scripts/check-budget.mjs",
    "audit:desktop": "node scripts/check-budget.mjs && lighthouse http://127.0.0.1:3000 --preset=desktop --chrome-flags=--headless=new --output=json --output-path=./artifacts/lighthouse-desktop.json && node scripts/check-lighthouse.mjs"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/dm-sans": "5.3.0",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@react-three/postprocessing": "3.2.2",
    "gsap": "3.15.1",
    "lenis": "1.3.27",
    "lucide-react": "1.61.0",
    "next": "16.4.5",
    "postprocessing": "6.39.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.181.2",
    "zustand": "5.0.16"
  },
  "overrides": {
    "serve": {
      "compression": "1.8.2"
    }
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.181.0",
    "eslint": "9.39.1",
    "eslint-config-next": "16.4.5",
    "lighthouse": "13.6.0",
    "serve": "14.2.6",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  }
}
